.launches/
.settings/
validation/
.vscode/
Release/
out/

# anlu fpga
*_Runs/
*.rpt
*.tsm
*.log
watch/


# Vivado / Xilinx SDK: zynq_hvsmu1_4 only
/zynq_hvsmu1_4/*.cache/
/zynq_hvsmu1_4/*.hw/
/zynq_hvsmu1_4/*.runs/
/zynq_hvsmu1_4/*.sim/
/zynq_hvsmu1_4/*.gen/
/zynq_hvsmu1_4/*.ip_user_files/
/zynq_hvsmu1_4/.Xil/
/zynq_hvsmu1_4/**/*.jou
/zynq_hvsmu1_4/**/*.str
/zynq_hvsmu1_4/**/*.dcp
/zynq_hvsmu1_4/**/*.bit
/zynq_hvsmu1_4/**/*.ltx
/zynq_hvsmu1_4/**/vivado*.pb

# Standalone IP output products; retain the IP configurations
/zynq_hvsmu1_4/hvsmu.srcs/sources_1/ip/**/*
!/zynq_hvsmu1_4/hvsmu.srcs/sources_1/ip/**/
!/zynq_hvsmu1_4/hvsmu.srcs/sources_1/ip/**/*.xci

# BD output products; retain system.bd and hdl/system_wrapper.v
/zynq_hvsmu1_4/hvsmu.srcs/sources_1/bd/*/ip/
/zynq_hvsmu1_4/hvsmu.srcs/sources_1/bd/*/ipshared/
/zynq_hvsmu1_4/hvsmu.srcs/sources_1/bd/*/sim/
/zynq_hvsmu1_4/hvsmu.srcs/sources_1/bd/*/synth/
/zynq_hvsmu1_4/hvsmu.srcs/sources_1/bd/*/hw_handoff/
/zynq_hvsmu1_4/hvsmu.srcs/sources_1/bd/*/ui/
/zynq_hvsmu1_4/hvsmu.srcs/sources_1/bd/*/*.bxml
/zynq_hvsmu1_4/hvsmu.srcs/sources_1/bd/*/*_ooc.xdc

# SDK workspace state and compiled outputs; retain application/FSBL sources,
# BSP configuration/sources, Eclipse project files and hardware handoff HDFs
/zynq_hvsmu1_4/hvsmu.sdk/.metadata/
/zynq_hvsmu1_4/hvsmu.sdk/RemoteSystemsTempFiles/
/zynq_hvsmu1_4/hvsmu.sdk/webtalk/
/zynq_hvsmu1_4/hvsmu.sdk/**/Debug/
/zynq_hvsmu1_4/hvsmu.sdk/**/Release/
/zynq_hvsmu1_4/hvsmu.sdk/**/*.elf
/zynq_hvsmu1_4/hvsmu.sdk/**/*.o
/zynq_hvsmu1_4/hvsmu.sdk/**/*.a
/zynq_hvsmu1_4/hvsmu.sdk/**/*.d
/zynq_hvsmu1_4/hvsmu.sdk/**/*.map
/zynq_hvsmu1_4/hvsmu.sdk/**/*.size
/zynq_hvsmu1_4/hvsmu.sdk/FSBL/bootimage/*.bin
/zynq_hvsmu1_4/hvsmu.sdk/*_bsp/ps7_cortexa9_0/include/
/zynq_hvsmu1_4/hvsmu.sdk/*_bsp/ps7_cortexa9_0/lib/

# ModelSim compiled libraries, waveforms and local session state
/zynq_hvsmu1_4/src/testbench/work/
/zynq_hvsmu1_4/src/testbench/*.wlf
/zynq_hvsmu1_4/src/testbench/*.cr.mti
